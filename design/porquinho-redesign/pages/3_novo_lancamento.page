    fill: {type: solid, color: "#263241"}
  - elementId: user-avatar-letter
    elementType: text
    bounds: [20, 850, 32, 32]
    content:
      fontFamily: Inter
      fontSize: 13
      bold: true
      color: "$text"
      align: [center, middle]
      wrap: false
      text: G
  - elementId: user-name
    elementType: text
    bounds: [62, 852, 170, 15]
    content:
      fontFamily: Inter
      fontSize: 13
      color: "$text"
      wrap: false
      text: GZila Teste
  - elementId: user-email
    elementType: text
    bounds: [62, 869, 170, 12]
    content:
      style: "$muted"
      wrap: false
      text: gzila3030@gmail.com

  # ================= Header =================
  - elementId: page-title
    elementType: text
    bounds: [264, 26, 500, 32]
    content:
      style: "$h1"
      wrap: false
      text: Novo lançamento
  - elementId: page-sub
    elementType: text
    bounds: [264, 60, 600, 16]
    content:
      fontFamily: Inter
      fontSize: 13
      color: "$muted"
      wrap: false
      text: Registre uma entrada, gasto ou investimento.

  # ================= Formulário =================
  - elementId: form-card
    elementType: shape
    bounds: [264, 108, 760, 610]
    shapeName: roundRect
    adjustments: [1800]
    fill: {type: solid, color: "$surface"}
    border: {style: solid, width: 1, color: "$border"}

  - elementId: type-label
    elementType: text
    bounds: [288, 130, 200, 13]
    content: {style: "$muted", wrap: false, text: Tipo de lançamento}

  # Segmented control
  - elementId: seg-bg
    elementType: shape
    bounds: [288, 148, 712, 44]
    shapeName: roundRect
    adjustments: [18000]
    fill: {type: solid, color: "$input"}
    border: {style: solid, width: 1, color: "$border"}
  - elementId: seg-active
