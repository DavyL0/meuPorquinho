    border: {style: solid, width: 1, color: "$border"}
  - elementId: obs-text
    elementType: text
    bounds: [302, 502, 660, 16]
    content: {fontFamily: Inter, fontSize: 13, color: "$faint", wrap: false, text: "Detalhes adicionais..."}

