    bounds: [24, 382, 160, 12]
    content:
      fontFamily: Inter
      fontSize: 10
      letterSpacing: 1.5
      color: "$faint"
      wrap: false
      text: CONTA
  - elementId: nav-icon-7
    elementType: icon
    bounds: [28, 412, 16, 16]
    iconName: "fas:right-from-bracket"
    fill: {type: solid, color: "$muted"}
  - elementId: nav-text-7
    elementType: text
    bounds: [56, 412, 160, 16]
    content: {style: "$nav", wrap: false, text: Sair}

  - elementId: sidebar-footer-line
    elementType: shape
    bounds: [16, 836, 208, 1]
    shapeName: rect
    fill: {type: solid, color: "$border"}
  - elementId: user-avatar
    elementType: shape
    bounds: [20, 850, 32, 32]
