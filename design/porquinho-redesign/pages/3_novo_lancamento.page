pageType: content
background:
  type: solid
  color: "$bg"
elements:
  # ================= Sidebar =================
  - elementId: sidebar-bg
    elementType: shape
    bounds: [0, 0, 240, 900]
    shapeName: rect
    fill: {type: solid, color: "$sidebar"}
  - elementId: sidebar-hairline
    elementType: shape
    bounds: [239, 0, 1, 900]
    shapeName: rect
    fill: {type: solid, color: "$border"}

  - elementId: logo-icon
    elementType: icon
    bounds: [22, 26, 28, 28]
    iconName: "fas:piggy-bank"
    fill: {type: solid, color: "$accent"}
  - elementId: logo-name
    elementType: text
    bounds: [60, 26, 150, 22]
    content:
      fontFamily: Inter
      fontSize: 17
      bold: true
      color: "$text"
      wrap: false
      text: Porquinho
  - elementId: logo-sub
    elementType: text
    bounds: [60, 48, 150, 13]
    content:
      style: "$muted"
      wrap: false
      text: Finanças pessoais

  - elementId: nav-label-1
    elementType: text
    bounds: [24, 104, 160, 12]
    content:
      fontFamily: Inter
      fontSize: 10
      letterSpacing: 1.5
      color: "$faint"
      wrap: false
      text: PRINCIPAL

  - elementId: nav-icon-1
    elementType: icon
    bounds: [28, 134, 16, 16]
    iconName: "fas:table-columns"
    fill: {type: solid, color: "$muted"}
  - elementId: nav-text-1
    elementType: text
    bounds: [56, 134, 160, 16]
    content: {style: "$nav", wrap: false, text: Dashboard}

  # Nav item ativo — Novo lançamento
