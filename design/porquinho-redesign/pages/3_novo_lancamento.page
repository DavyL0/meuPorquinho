    bounds: [28, 334, 16, 16]
    iconName: "fas:user"
    fill: {type: solid, color: "$muted"}
  - elementId: nav-text-6
    elementType: text
    bounds: [56, 334, 160, 16]
    content: {style: "$nav", wrap: false, text: Perfil}

  - elementId: nav-label-2
