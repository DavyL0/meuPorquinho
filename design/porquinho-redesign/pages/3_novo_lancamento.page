    adjustments: [11000]
    fill: {type: solid, color: "$input"}
    border: {style: solid, width: 1, color: "$border"}
  - elementId: valor-text
    elementType: text
    bounds: [302, 246, 300, 20]
    content: {fontFamily: Inter, fontSize: 16, color: "$faint", wrap: false, text: "0,00"}

  # Data
  - elementId: data-label
    elementType: text
    bounds: [656, 214, 200, 13]
    content: {style: "$muted", wrap: false, text: Data}
  - elementId: data-input
    elementType: shape
    bounds: [656, 232, 344, 48]
