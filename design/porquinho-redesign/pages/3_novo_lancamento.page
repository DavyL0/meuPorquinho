  - elementId: data-text
    elementType: text
    bounds: [670, 246, 200, 20]
    content: {fontFamily: Inter, fontSize: 16, color: "$body", wrap: false, text: "11/11/2026"}
  - elementId: data-icon
    elementType: icon
    bounds: [970, 248, 15, 15]
