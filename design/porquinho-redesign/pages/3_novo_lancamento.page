  - elementId: desc-text
    elementType: text
    bounds: [302, 334, 660, 16]
    content: {fontFamily: Inter, fontSize: 13, color: "$faint", wrap: false, text: "Ex: Supermercado, salário, combustível..."}

  # Categoria
