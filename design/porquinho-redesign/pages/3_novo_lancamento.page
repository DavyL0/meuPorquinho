    adjustments: [50000]
    fill: {type: solid, color: "$accent"}
  - elementId: nav-icon-2
    elementType: icon
    bounds: [28, 174, 16, 16]
    iconName: "fas:circle-plus"
    fill: {type: solid, color: "$accent"}
  - elementId: nav-text-2
    elementType: text
    bounds: [56, 174, 160, 16]
    content:
      fontFamily: Inter
      fontSize: 13
      bold: true
      color: "$text"
      wrap: false
      text: Novo lançamento

  - elementId: nav-icon-3
    elementType: icon
    bounds: [28, 214, 16, 16]
