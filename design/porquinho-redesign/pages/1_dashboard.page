      wrap: false
      text: Últimos 6 meses
  - elementId: evo-chart
    elementType: chart
    bounds: [280, 288, 720, 224]
    fontFamily: Inter
    legend: {position: top, color: "$muted", fontSize: 11}
    data:
      cols: [mes, Entradas, Gastos, Investimentos]
      rows:
        - [jun, 7200, 4100, 800]
        - [jul, 7450, 4350, 1000]
        - [ago, 7800, 3980, 1200]
        - [set, 7300, 4520, 1200]
        - [out, 7850, 4090, 1500]
        - [nov, 7850, 4213, 1500]
    seriesDefaults:
      bar: {}
    series:
      - type: bar
        encode: {x: mes, y: Entradas}
        name: Entradas
        fill: "$accent"
      - type: bar
        encode: {x: mes, y: Gastos}
        name: Gastos
        fill: "$red"
      - type: bar
        encode: {x: mes, y: Investimentos}
        name: Investimentos
        fill: "$purple"
    xAxis:
      label: {color: "$muted", fontSize: 10}
      axisLine: {color: "$border"}
      gridLine: false
    yAxis:
      label: {color: "$muted", fontSize: 10, numberFormat: "#,##0"}
