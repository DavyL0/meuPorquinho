# ============================================================
# Meu Porquinho — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA deve ser commitado (já está no .gitignore).
# ============================================================

# Banco de dados (docker-compose)
POSTGRES_DB=financas
POSTGRES_USER=financas_user
POSTGRES_PASSWORD=troque-esta-senha

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@financas.local
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha

# Backend — obrigatório para subir a API.
# Gere um segredo forte com: openssl rand -base64 48
JWT_SECRET=
# Validade do token em milissegundos (opcional, padrão: 3600000 = 1h)
# JWT_EXPIRATION=3600000

# Envio de e-mail (alertas de investimento).
# Sem MAIL_HOST, os alertas são apenas registrados no log do backend.
# Exemplo Gmail: MAIL_HOST=smtp.gmail.com + senha de app (não a senha normal).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Porquinho <no-reply@porquinho.local>

# Monitoramento de cotações (Binance)
# Intervalo entre verificações em ms (padrão: 60000 = 1 min)
# MONITORAMENTO_INTERVALO=60000
